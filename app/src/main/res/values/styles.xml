<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/blanco</item>
        <item name="colorPrimary">@color/verde_oscuro</item>
        <item name="colorPrimaryVariant">@color/verde_oscuro</item>
        <item name="colorPrimaryDark">@color/verde_oscuro</item>
        <item name="colorSecondary">@color/verde_campo</item>
        <item name="android:statusBarColor">@color/verde_oscuro</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Boton de texto compacto para las barras oscuras del editor -->
    <style name="BotonBarra" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Botones del selector de herramienta (mover / tipos de flecha) -->
    <style name="BotonHerramienta" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/selector_texto_herramienta</item>
        <item name="backgroundTint">@color/selector_fondo_herramienta</item>
        <item name="strokeColor">#78909C</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Campo de texto sobre la barra verde -->
    <style name="CampoBarra">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#A5D6A7</item>
        <item name="android:textSize">15sp</item>
        <item name="android:backgroundTint">#A5D6A7</item>
        <item name="android:singleLine">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
